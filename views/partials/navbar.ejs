<style>
  .navbar-glass {
    background: rgba(15, 23, 42, 0.8) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .navbar-brand-gradient {
    font-weight: 800;
    background: linear-gradient(to right, #38bdf8, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.05em;
    font-size: 1.5rem;
  }
  .nav-link-custom {
    color: #cbd5e1 !important;
    font-weight: 500;
    transition: color 0.3s ease;
  }
  .nav-link-custom:hover {
    color: #38bdf8 !important;
  }
  .btn-nav-action {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
    border: none;
    color: white;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .btn-nav-action:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 15px -5px rgba(56, 189, 248, 0.6);
    color: white;
  }
  .btn-nav-outline {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    background: rgba(255,255,255,0.05);
    transition: all 0.3s ease;
  }
  .btn-nav-outline:hover {
    background: rgba(255,255,255,0.1);
    color: white;
  }
</style>

<nav class="navbar sticky-top navbar-expand-lg navbar-dark navbar-glass py-3">
  <div class="container">

    <a class="navbar-brand navbar-brand-gradient" href="/">CampVista</a>

    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- Left side -->
      <div class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
        <a class="nav-link nav-link-custom mx-2" href="/">Home</a>
        <a class="nav-link nav-link-custom mx-2" href="/campgrounds">Campgrounds</a>
        <a class="nav-link nav-link-custom mx-2" href="/campgrounds/new">New Campground</a>
      </div>

      <!-- Right side -->
      <div class="navbar-nav ms-auto d-flex align-items-center gap-3">
        <% if(!currentUser) { %>
          <a href="/login" class="nav-link nav-link-custom">Login</a>
          <a href="/register" class="btn btn-nav-action text-decoration-none">Register</a>
        <% } else { %>
          <a href="/my-bookings" class="nav-link nav-link-custom">My Bookings</a>
          <form action="/logout" method="POST" class="m-0 p-0">
            <button type="submit" class="btn btn-nav-outline">
              Logout
            </button>
          </form>
        <% } %>
      </div>

    </div>
  </div>
</nav>
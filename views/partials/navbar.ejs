<header class="header">
  <div class="container nav-wrap">
    <!-- Brand Logo with Camp Icon -->
    <a class="logo" href="/" aria-label="CampVista Home">
      <span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 20 12 4l9 16M7.5 20 12 12l4.5 8M3 20h18" />
        </svg>
      </span>
      CampVista
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav">
      <a href="/" class="<%= (typeof page !== 'undefined' && page === 'home') ? 'active' : '' %>">Home</a>
      <a href="/campgrounds" class="<%= (typeof page !== 'undefined' && page === 'explore') ? 'active' : '' %>">Explore camps</a>
      <a href="/#why-campvista">How it works</a>
      
      <% if (currentUser && (currentUser.role === 'owner' || currentUser.role === 'admin')) { %>
        <a href="/manage-bookings" class="<%= (typeof page !== 'undefined' && page === 'dashboard') ? 'active' : '' %> position-relative">
          Host dashboard
          <% if (pendingBookingsCount > 0) { %>
            <span class="badge rounded-pill bg-danger ms-1" style="font-size: 0.65rem;">
              <%= pendingBookingsCount %>
            </span>
          <% } %>
        </a>
      <% } else if (currentUser && currentUser.role === 'customer') { %>
        <form action="/upgrade-role" method="POST" class="d-inline m-0 p-0">
          <button type="submit" class="border-0 bg-transparent p-0 fw-semibold text-secondary" style="font-size: 13px;">Host a camp</button>
        </form>
      <% } else { %>
        <a href="/campgrounds/new">Host a camp</a>
      <% } %>
    </nav>

    <!-- Nav Actions / User Auth -->
    <div class="nav-actions">
      <% if (!currentUser) { %>
        <a href="/login" class="btn btn-ghost">Log in</a>
        <a href="/register" class="btn btn-primary btn-sm">Sign up</a>
      <% } else { %>
        <a href="/my-bookings" class="my-trips">My trips</a>
        <div id="user-button"></div>
      <% } %>

      <!-- Mobile Hamburger Button -->
      <button class="menu-button" type="button" data-bs-toggle="collapse" data-bs-target="#mobileHeaderMenu" aria-controls="mobileHeaderMenu" aria-expanded="false" aria-label="Toggle navigation">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div class="collapse d-lg-none bg-white border-bottom shadow-sm px-4 py-3" id="mobileHeaderMenu">
    <div class="d-flex flex-column gap-2">
      <a href="/" class="py-2 text-dark fw-bold">Home</a>
      <a href="/campgrounds" class="py-2 text-dark fw-bold">Explore camps</a>
      <a href="/#why-campvista" class="py-2 text-secondary">How it works</a>
      <% if (currentUser && (currentUser.role === 'owner' || currentUser.role === 'admin')) { %>
        <a href="/manage-bookings" class="py-2 text-dark fw-bold d-flex justify-content-between align-items-center">
          Host dashboard
          <% if (pendingBookingsCount > 0) { %>
            <span class="badge bg-danger rounded-pill"><%= pendingBookingsCount %></span>
          <% } %>
        </a>
      <% } %>
      <% if (currentUser) { %>
        <a href="/my-bookings" class="py-2 text-dark">My trips</a>
      <% } else { %>
        <hr class="my-2">
        <a href="/login" class="btn btn-outline w-100 py-2">Log in</a>
        <a href="/register" class="btn btn-primary w-100 py-2 mt-2">Sign up</a>
      <% } %>
    </div>
  </div>
</header>
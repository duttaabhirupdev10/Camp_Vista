<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>CampVista | Your Gateway to the Wild</title>
    
    <!-- Google Fonts: DM Serif Display & Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Design System Styles -->
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="d-flex flex-column min-vh-100">
    <%- include('../partials/navbar') %>
    
    <main class="flex-grow-1">
        <%- body %>
    </main>
    
    <%- include('../partials/footer') %>
    
    <!-- Mobile Bottom Navigation Bar -->
    <nav class="mobile-bottom">
        <a href="/campgrounds" class="<%= (typeof page !== 'undefined' && page === 'explore') ? 'active' : '' %>">
            <i class="bi bi-compass fs-5"></i>
            <span>Explore</span>
        </a>
        <a href="/my-bookings" class="<%= (typeof page !== 'undefined' && page === 'bookings') ? 'active' : '' %>">
            <i class="bi bi-calendar-check fs-5"></i>
            <span>Bookings</span>
        </a>
        <% if (currentUser && (currentUser.role === 'owner' || currentUser.role === 'admin')) { %>
        <a href="/manage-bookings" class="<%= (typeof page !== 'undefined' && page === 'dashboard') ? 'active' : '' %>">
            <i class="bi bi-speedometer2 fs-5"></i>
            <span>Dashboard</span>
        </a>
        <% } else { %>
        <a href="/campgrounds/new">
            <i class="bi bi-plus-circle fs-5"></i>
            <span>Host</span>
        </a>
        <% } %>
        <% if (!currentUser) { %>
        <a href="/login">
            <i class="bi bi-person fs-5"></i>
            <span>Login</span>
        </a>
        <% } else { %>
        <a href="/my-bookings">
            <i class="bi bi-person-circle fs-5"></i>
            <span>Account</span>
        </a>
        <% } %>
    </nav>

    <!-- Bootstrap 5.3 Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Clerk JS Setup -->
    <script>
      const clerkPubKey = "<%= clerkPublishableKey %>";
    </script>
    <script
      async
      crossorigin="anonymous"
      data-clerk-publishable-key="<%= clerkPublishableKey %>"
      src="https://cdn.jsdelivr.net/npm/@clerk/clerk-js@5/dist/clerk.browser.js"
      type="text/javascript"
    ></script>
    <script>
      window.addEventListener("load", async function () {
        if (typeof Clerk !== "undefined" && clerkPubKey) {
          await Clerk.load();
          if (Clerk.user) {
            const userButtonDiv = document.getElementById("user-button");
            if (userButtonDiv) Clerk.mountUserButton(userButtonDiv);
          }
        }
      });
    </script>
</body>
</html>
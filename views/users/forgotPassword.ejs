<% layout('layouts/boilerplate') %>

<style>
    body {
        background: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1523987355523-c7b5b0dd90a7?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
        color: white;
    }
    .auth-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        margin-top: 2rem;
        margin-bottom: 2rem;
    }
    .auth-card .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
    }
    .auth-card .form-control:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: #38bdf8;
        box-shadow: 0 0 0 0.25rem rgba(56, 189, 248, 0.25);
        color: white;
    }
    .auth-card .btn-primary {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
        border: none;
        padding: 0.75rem;
        font-weight: 600;
        width: 100%;
        border-radius: 10px;
    }
    .auth-card .btn-primary:hover {
        box-shadow: 0 10px 20px -10px rgba(56, 189, 248, 0.7);
        transform: translateY(-1px);
    }
    .auth-card a {
        color: #38bdf8;
        text-decoration: none;
    }
    .auth-card a:hover {
        text-decoration: underline;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="auth-card">
            <h1 class="text-center mb-4 font-weight-bold">Forgot Password</h1>
            <p class="text-center mb-4" style="color: #cbd5e1;">Enter your email address and we will send you a link to reset your password.</p>

        <form action="/forgot-password" method="POST">

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input 
                    type="email" 
                    class="form-control" 
                    id="email" 
                    name="email" 
                    required
                >
            </div>

            <button class="btn btn-primary w-100">Send Reset Link</button>

        </form>

        <p class="mt-3 text-center">
            Remembered your password?
            <a href="/login">Login</a>
        </p>

        </div>

    </div>
</div>

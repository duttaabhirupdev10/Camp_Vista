<% layout('layouts/boilerplate') %>

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="w-100 d-flex flex-column align-items-center">
        <!-- Clerk will inject the sign up form here -->
        <div id="sign-up-container"></div>
    </div>
</div>

<!-- Clerk JS Mounting -->
<script>
    window.addEventListener("load", async function () {
        if (typeof Clerk !== "undefined") {
            await Clerk.load();
            const signUpContainer = document.getElementById("sign-up-container");
            if (signUpContainer) {
                Clerk.mountSignUp(signUpContainer, { routing: 'hash' });
            }
        }
    });
</script>
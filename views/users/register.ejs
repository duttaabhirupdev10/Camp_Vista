<% layout('layouts/boilerplate') %>

<style>
    body {
        background: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1542224566-6e85f2e6772f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
        color: white;
    }
    .auth-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        margin-top: 2rem;
        margin-bottom: 2rem;
    }
    .auth-card .form-control, .auth-card .form-select {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
    }
    .auth-card .form-control:focus, .auth-card .form-select:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: #38bdf8;
        box-shadow: 0 0 0 0.25rem rgba(56, 189, 248, 0.25);
        color: white;
    }
    .auth-card .form-select option {
        color: black;
    }
    .auth-card .btn-outline-secondary {
        border-color: rgba(255, 255, 255, 0.2);
        color: #cbd5e1;
    }
    .auth-card .btn-outline-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }
    .auth-card .btn-primary {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
        border: none;
        padding: 0.75rem;
        font-weight: 600;
        width: 100%;
        border-radius: 10px;
    }
    .auth-card .btn-primary:hover {
        box-shadow: 0 10px 20px -10px rgba(56, 189, 248, 0.7);
        transform: translateY(-1px);
    }
    .auth-card a {
        color: #38bdf8;
        text-decoration: none;
    }
    .auth-card a:hover {
        text-decoration: underline;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="auth-card">
            <h1 class="text-center mb-4 font-weight-bold">Register</h1>

        <form action="/register" method="POST">

            <div class="mb-3">
                <label for="email" class="form-label">
                    Email
                </label>

                <input
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                    required
                >
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">
                    Password
                </label>

                <div class="input-group">
                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        required
                    >
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label for="role" class="form-label">
                    Role
                </label>
                <select class="form-select" id="role" name="role" required>
                    <option value="customer" selected>Customer</option>
                    <option value="owner">Room Owner</option>
                </select>
            </div>

            <button class="btn btn-primary">
                Register
            </button>

        </form>

        <p class="mt-3">
            Already have an account?
            <a href="/login">Login</a>
        </p>

        </div>

    </div>
</div>

<script>
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');

    togglePassword.addEventListener('click', function () {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        this.querySelector('i').classList.toggle('bi-eye');
        this.querySelector('i').classList.toggle('bi-eye-slash');
    });
</script>
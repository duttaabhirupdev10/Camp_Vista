<% layout('layouts/boilerplate') %>

<style>
    body {
        background: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1523987355523-c7b5b0dd90a7?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
        color: white;
    }
    .auth-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        margin-top: 2rem;
        margin-bottom: 2rem;
    }
    .auth-card .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
    }
    .auth-card .form-control:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: #38bdf8;
        box-shadow: 0 0 0 0.25rem rgba(56, 189, 248, 0.25);
        color: white;
    }
    .auth-card .btn-outline-secondary {
        border-color: rgba(255, 255, 255, 0.2);
        color: #cbd5e1;
    }
    .auth-card .btn-outline-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }
    .auth-card .btn-primary {
        background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
        border: none;
        padding: 0.75rem;
        font-weight: 600;
        width: 100%;
        border-radius: 10px;
    }
    .auth-card .btn-primary:hover {
        box-shadow: 0 10px 20px -10px rgba(56, 189, 248, 0.7);
        transform: translateY(-1px);
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="auth-card">
            <h1 class="text-center mb-4 font-weight-bold">Reset Password</h1>

        <form action="/reset-password" method="POST" id="resetPasswordForm">
            
            <input type="hidden" name="token" id="tokenField">
            <input type="hidden" name="refreshToken" id="refreshTokenField">

            <div class="mb-3">
                <label for="password" class="form-label">New Password</label>
                <div class="input-group">
                    <input 
                        type="password" 
                        class="form-control" 
                        id="password" 
                        name="password" 
                        required
                    >
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button class="btn btn-primary w-100">Update Password</button>

        </form>

        </div>
    </div>
</div>

<script>
    // Handle show/hide password toggle
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');

    togglePassword.addEventListener('click', function () {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        this.querySelector('i').classList.toggle('bi-eye');
        this.querySelector('i').classList.toggle('bi-eye-slash');
    });

    // Handle token extraction from URL hash fragment
    document.addEventListener('DOMContentLoaded', () => {
        const hash = window.location.hash.substring(1);
        const params = new URLSearchParams(hash);
        const token = params.get('access_token');
        const refreshToken = params.get('refresh_token');
        
        if (token) {
            document.getElementById('tokenField').value = token;
            if(refreshToken) document.getElementById('refreshTokenField').value = refreshToken;
        } else {
            // Check query string just in case PKCE is enabled
            const searchParams = new URLSearchParams(window.location.search);
            const code = searchParams.get('code');
            if(code) {
               document.getElementById('tokenField').value = code;
            }
        }
    });

    // Form submission validation
    document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
        if (!document.getElementById('tokenField').value) {
            e.preventDefault();
            alert('Reset token not found in the URL. Please make sure you clicked the full link sent to your email.');
        }
    });
</script>

<% layout('layouts/boilerplate') %>

<% 
    const isAdm = (typeof isAdmin !== 'undefined' && isAdmin) || (currentUser && currentUser.role === 'admin');
    const totalCount = (bookings && bookings.length) || 0;
    const pendingCount = (bookings && bookings.filter(b => b.status === 'pending').length) || 0;
    const paidCount = (bookings && bookings.filter(b => b.status === 'paid' || b.status === 'confirmed').length) || 0;
    const totalRevenue = (bookings && bookings.filter(b => b.status === 'paid' || b.status === 'confirmed').reduce((acc, b) => acc + Number(b.total_price || 0), 0)) || 0;
%>

<main class="container py-5">
    <div class="dash-top">
        <div>
            <span><%= isAdm ? 'PLATFORM ADMIN DASHBOARD' : 'CAMP OWNER DASHBOARD' %></span>
            <h1><%= isAdm ? 'Admin Booking Management' : 'Host Management Portal' %></h1>
            <p><%= isAdm ? 'Review and manage all customer reservations and direct UPI payments across all campsites.' : 'Review customer reservations and approve direct UPI payments for your campsites.' %></p>
        </div>
        <div class="dash-actions">
            <a href="/campgrounds/new" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Campsite
            </a>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stats mb-4">
        <article>
            <div>
                <span>Total Bookings</span>
                <strong><%= totalCount %></strong>
            </div>
            <i class="stat-icon">
                <i class="bi bi-calendar-check"></i>
            </i>
            <small>All time reservations</small>
        </article>

        <article>
            <div>
                <span>Pending Approvals</span>
                <strong class="text-warning"><%= pendingCount %></strong>
            </div>
            <i class="stat-icon">
                <i class="bi bi-clock-history"></i>
            </i>
            <small><%= pendingCount > 0 ? 'Action required' : 'All clear' %></small>
        </article>

        <article>
            <div>
                <span>Paid Revenue</span>
                <strong class="text-success">₹<%= totalRevenue.toLocaleString('en-IN') %></strong>
            </div>
            <i class="stat-icon">
                <i class="bi bi-wallet2"></i>
            </i>
            <small><%= paidCount %> confirmed stays</small>
        </article>

        <article>
            <div>
                <span><%= isAdm ? 'Admin Access' : 'Host Status' %></span>
                <strong><%= isAdm ? 'Super Admin' : 'Verified' %></strong>
            </div>
            <i class="stat-icon">
                <i class="bi bi-shield-check"></i>
            </i>
            <small><%= isAdm ? 'All Platform Campsites' : 'CampVista Host Partner' %></small>
        </article>
    </div>

    <!-- Properties & Room Availability Section -->
    <section class="recent mb-4">
        <div class="card-title mb-3">
            <div>
                <h2>Properties &amp; Room Availability <%= isAdm ? '(All Campsites)' : '' %></h2>
                <p>Current room availability across your listed properties</p>
            </div>
        </div>

        <% if (typeof campgrounds !== 'undefined' && campgrounds && campgrounds.length > 0) { %>
            <div class="row g-3">
                <% for (let camp of campgrounds) { %>
                            <%
                                const avail = Number(camp.available_rooms ?? 0);
                                const total = Number(camp.total_rooms ?? 5);
                                const cap = Math.max(1, Number(camp.room_capacity ?? 2));
                            %>
                            <div class="col-md-6 col-lg-4">
                                <div class="border rounded-3 p-3 bg-white h-100 d-flex flex-column justify-content-between gap-2">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                            <h5 class="fw-bold mb-0" style="font-size: 15px;"><%= camp.title %></h5>
                                            <a href="/campgrounds/<%= camp.id %>/edit" class="btn btn-outline btn-sm py-1 px-2" style="font-size: 11px;">Edit</a>
                                        </div>
                                        <small class="text-muted d-block mb-2"><%= camp.location %></small>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top flex-wrap gap-2">
                                        <span class="text-muted small">Total: <strong><%= total %></strong> &middot; Max: <strong><%= cap %>/room</strong></span>
                                        <% if (avail > 0) { %>
                                            <span class="availability-badge available">
                                                <i class="bi bi-door-open"></i>
                                                <%= avail %> <%= avail === 1 ? 'room' : 'rooms' %> available
                                            </span>
                                        <% } else { %>
                                            <span class="availability-badge sold-out">
                                                <i class="bi bi-x-circle"></i>
                                                No rooms available
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                <% } %>
            </div>
        <% } else { %>
            <p class="text-muted small mb-0">No properties listed yet.</p>
        <% } %>
    </section>

    <!-- Bookings Table Section -->
    <section class="recent">
        <div class="card-title mb-3">
            <div>
                <h2>Reservation Requests <%= isAdm ? '(All Campsites)' : '' %></h2>
                <p>Verify customer payments and confirm bookings</p>
            </div>
        </div>

        <% if (bookings && bookings.length > 0) { %>
            <div class="table-responsive">
                <div class="table-custom">
                    <div class="tr th">
                        <span>Campground</span>
                        <span>Customer</span>
                        <span>Dates</span>
                        <span>Amount</span>
                        <span>Status</span>
                        <span>Actions</span>
                    </div>

                    <% for (let booking of bookings) { %>
                        <div class="tr">
                            <span>
                                <i class="table-thumb" style="background-image: url('<%= (booking.campgrounds && booking.campgrounds.image) || 'https://images.unsplash.com/photo-1715092387304-ef4d5f41ffdb?auto=format&fit=crop&w=200&q=80' %>');"></i>
                                <span><%= booking.campgrounds ? booking.campgrounds.title : 'Campground' %></span>
                            </span>
                            
                            <span class="text-truncate" style="max-width: 180px;">
                                <%= (booking.users && booking.users.email) ? booking.users.email : 'Customer' %>
                            </span>

                            <span>
                                <small class="d-block fw-semibold"><%= new Date(booking.check_in).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) %></small>
                                <small class="text-muted">to <%= new Date(booking.check_out).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) %></small>
                            </span>

                            <strong class="text-success">₹<%= Number(booking.total_price || 0).toLocaleString('en-IN') %></strong>

                            <span>
                                <% if (booking.status === 'paid' || booking.status === 'confirmed') { %>
                                    <em class="status confirmed">Paid</em>
                                <% } else if (booking.status === 'pending') { %>
                                    <em class="status pending">Pending</em>
                                <% } else { %>
                                    <em class="status cancelled">Cancelled</em>
                                <% } %>
                            </span>

                            <span>
                                <% if (booking.status === 'pending') { %>
                                    <div class="d-flex gap-2">
                                        <form action="/manage-bookings/<%= booking.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="paid">
                                            <button type="submit" class="btn btn-primary btn-sm py-1 px-2" style="font-size: 11px;">Confirm</button>
                                        </form>
                                        <form action="/manage-bookings/<%= booking.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="cancelled">
                                            <button type="submit" class="btn btn-outline btn-sm py-1 px-2 text-danger" style="font-size: 11px;">Reject</button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <span class="text-muted small">Processed</span>
                                <% } %>
                            </span>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <div class="text-center py-5 bg-light rounded-3">
                <i class="bi bi-inbox fs-1 text-muted mb-2 d-block"></i>
                <h5 class="fw-bold">No reservations yet</h5>
                <p class="text-muted small">When campers book listings, their reservations will appear here for confirmation.</p>
            </div>
        <% } %>
    </section>
</main>

<% layout('layouts/boilerplate') %>

<div class="container mt-5">
    <h1 class="fw-bold mb-4">Manage Bookings</h1>
    <p class="text-muted mb-4">View and approve payments for users who have booked your campgrounds.</p>

    <% if (bookings && bookings.length > 0) { %>
        <div class="table-responsive bg-white rounded-3 shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="px-4 py-3">Campground</th>
                        <th scope="col" class="px-4 py-3">Customer Email</th>
                        <th scope="col" class="px-4 py-3">Dates</th>
                        <th scope="col" class="px-4 py-3">Amount</th>
                        <th scope="col" class="px-4 py-3">Status</th>
                        <th scope="col" class="px-4 py-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let booking of bookings) { %>
                        <tr>
                            <td class="px-4 py-3 fw-semibold"><%= booking.campgrounds.title %></td>
                            <td class="px-4 py-3"><%= booking.users ? booking.users.email : 'Unknown' %></td>
                            <td class="px-4 py-3 text-nowrap">
                                <small class="d-block text-muted">In: <%= booking.check_in %></small>
                                <small class="d-block text-muted">Out: <%= booking.check_out %></small>
                            </td>
                            <td class="px-4 py-3 fw-bold text-success">₹<%= booking.total_price %></td>
                            <td class="px-4 py-3">
                                <% if (booking.status === 'pending') { %>
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Pending</span>
                                <% } else if (booking.status === 'paid') { %>
                                    <span class="badge bg-success px-3 py-2 rounded-pill">Paid</span>
                                <% } else { %>
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">Cancelled</span>
                                <% } %>
                            </td>
                            <td class="px-4 py-3 text-end">
                                <% if (booking.status === 'pending') { %>
                                    <form action="/manage-bookings/<%= booking.id %>/status" method="POST" class="d-inline-block">
                                        <input type="hidden" name="status" value="paid">
                                        <button type="submit" class="btn btn-sm btn-success fw-semibold">Confirm Payment</button>
                                    </form>
                                    <form action="/manage-bookings/<%= booking.id %>/status" method="POST" class="d-inline-block">
                                        <input type="hidden" name="status" value="cancelled">
                                        <button type="submit" class="btn btn-sm btn-outline-danger fw-semibold">Reject</button>
                                    </form>
                                <% } else { %>
                                    <span class="text-muted small">Processed</span>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-info-circle-fill me-2"></i> You don't have any bookings yet.
        </div>
    <% } %>
</div>

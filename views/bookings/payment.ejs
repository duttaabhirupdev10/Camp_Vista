<% layout('layouts/boilerplate') %>
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">
                <h3 class="fw-bold mb-3">Complete Your Payment</h3>
                <p class="text-muted mb-4">You are booking <strong><%= campground.title %></strong><br>From <%= check_in %> to <%= check_out %></p>
                
                <div class="bg-light rounded-3 p-4 mb-4">
                    <h5 class="text-secondary mb-1">Total Amount Due</h5>
                    <h2 class="display-5 fw-bold text-success mb-3">₹<%= total_price %></h2>
                    
                    <!-- Dummy QR Code -->
                    <div class="p-3 bg-white rounded-3 d-inline-block shadow-sm">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=upi://pay?pa=campvista@upi&pn=CampVista&am=<%= total_price %>&cu=INR" alt="UPI QR Code" class="img-fluid">
                    </div>
                    <p class="small text-muted mt-3">Scan this QR code with any UPI app (GPay, PhonePe, Paytm) to pay.</p>
                </div>

                <form action="/campgrounds/<%= campground.id %>/confirm-payment" method="POST">
                    <input type="hidden" name="check_in" value="<%= check_in %>">
                    <input type="hidden" name="check_out" value="<%= check_out %>">
                    <input type="hidden" name="total_price" value="<%= total_price %>">
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">I Have Completed the Payment</button>
                </form>
                
                <div class="mt-3">
                    <a href="/campgrounds/<%= campground.id %>" class="btn btn-link text-decoration-none text-secondary">Cancel Booking</a>
                </div>
            </div>
        </div>
    </div>
</div>

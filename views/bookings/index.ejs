<% layout('layouts/boilerplate') %>

<main class="bookings-page container">
    <div class="page-heading compact">
        <span class="eyebrow">
            <span></span> Your journeys
        </span>
        <h1>My bookings</h1>
        <p>Everything you need for your upcoming and past wilderness escapes.</p>
    </div>

    <!-- Tabs -->
    <div class="tabs">
        <a href="/my-bookings" class="active">
            All Trips <span><%= (bookings && bookings.length) || 0 %></span>
        </a>
    </div>

    <% if (bookings && bookings.length > 0) { %>
        <% for (let booking of bookings) { %>
            <article class="booking-item">
                <img src="<%= (booking.campgrounds && booking.campgrounds.image) || 'https://images.unsplash.com/photo-1715092387304-ef4d5f41ffdb?auto=format&fit=crop&w=800&q=85' %>" alt="<%= booking.campgrounds ? booking.campgrounds.title : 'Campground' %>">
                
                <div class="booking-info">
                    <div>
                        <% if (booking.status === 'paid' || booking.status === 'confirmed') { %>
                            <span class="status confirmed">Confirmed (Paid)</span>
                        <% } else if (booking.status === 'pending') { %>
                            <span class="status pending">Pending Approval</span>
                        <% } else { %>
                            <span class="status cancelled">Cancelled</span>
                        <% } %>
                        <small>Booking ID &middot; CV-<%= (booking.id || '').slice(-6).toUpperCase() %></small>
                    </div>

                    <h2><%= booking.campgrounds ? booking.campgrounds.title : 'Campground' %></h2>
                    
                    <p>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        <%= booking.campgrounds ? booking.campgrounds.location : 'North Bengal' %>
                    </p>

                    <div class="trip-facts">
                        <div>
                            <span>Check-in</span>
                            <strong><%= new Date(booking.check_in).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
                            <small class="text-muted">From 2:00 PM</small>
                        </div>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                        </svg>
                        <div>
                            <span>Check-out</span>
                            <strong><%= new Date(booking.check_out).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
                            <small class="text-muted">By 11:00 AM</small>
                        </div>
                        <div>
                            <span>Total Amount</span>
                            <strong class="text-success">₹<%= Number(booking.total_price || 0).toLocaleString('en-IN') %></strong>
                            <small class="text-muted">Direct UPI</small>
                        </div>
                        <div>
                            <span>Booking Date</span>
                            <strong><%= new Date(booking.created_at || Date.now()).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) %></strong>
                            <small class="text-muted">Recorded</small>
                        </div>
                    </div>

                    <div class="booking-actions">
                        <% if (booking.campground_id || (booking.campgrounds && booking.campgrounds.id)) { %>
                            <a href="/campgrounds/<%= booking.campground_id || booking.campgrounds.id %>" class="btn btn-primary btn-sm">
                                View campsite
                            </a>
                        <% } %>
                        <% if (booking.campgrounds && booking.campgrounds.location) { %>
                            <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(booking.campgrounds.location) %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
                                <i class="bi bi-sign-turn-right-fill me-1"></i> Get directions
                            </a>
                        <% } %>
                    </div>
                </div>
            </article>
        <% } %>
    <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-5 my-4 bg-white rounded-4 border p-5">
            <div class="mb-3">
                <i class="bi bi-compass display-3 text-secondary"></i>
            </div>
            <h3 class="fw-bold mb-2">No bookings yet</h3>
            <p class="text-muted mb-4">You haven't planned any trips yet. Discover handpicked nature stays and start your journey.</p>
            <a href="/campgrounds" class="btn btn-primary">Explore Campgrounds</a>
        </div>
    <% } %>

    <!-- Trip Inspiration Section -->
    <section class="trip-inspiration">
        <div>
            <span>Plan something new</span>
            <h2>
                The wild is always<br>
                worth returning to.
            </h2>
            <a href="/campgrounds" class="btn btn-secondary">
                Explore more camps
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </a>
        </div>
    </section>
</main>

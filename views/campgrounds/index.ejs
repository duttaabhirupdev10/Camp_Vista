<% layout('layouts/boilerplate') %>

<main class="explore-page container">
    <div class="page-heading">
        <span class="eyebrow">
            <span></span> Find your wild
        </span>
        <h1>Explore camps</h1>
        <p>Handpicked nature stays across the mountains, forests and rivers of North Bengal.</p>
    </div>

    <!-- Compact Search Panel -->
    <form action="/campgrounds" method="GET" class="search-panel search-compact mb-4">
        <label class="search-main">
            <span>Where</span>
            <div>
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                </svg>
                <input type="text" name="search" placeholder="Search by title, location or region..." value="<%= filters.search || '' %>">
            </div>
        </label>

        <label>
            <span>Max Price (₹)</span>
            <div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M4 6h15a2 2 0 0 1 2 2v11H4a2 2 0 0 1-2-2V5a3 3 0 0 1 3-3h13" />
                    <path d="M16 12h5" />
                </svg>
                <input type="number" name="maxPrice" placeholder="Any price" value="<%= filters.maxPrice || '' %>">
            </div>
        </label>

        <button type="submit" class="btn btn-primary">
            Search
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-4-4" />
            </svg>
        </button>

        <% if (filters.search || filters.maxPrice) { %>
            <a href="/campgrounds" class="btn btn-ghost" title="Clear search">Clear</a>
        <% } %>
    </form>

    <!-- Filters & Action Bar -->
    <div class="explore-tools">
        <div class="filter-chips">
            <a href="/campgrounds" class="<%= (!filters.search) ? 'active' : '' %>">All stays</a>
            <a href="/campgrounds?search=Forest" class="<%= (filters.search === 'Forest') ? 'active' : '' %>">Forest camps</a>
            <a href="/campgrounds?search=River" class="<%= (filters.search === 'River') ? 'active' : '' %>">River camps</a>
            <a href="/campgrounds?search=Mountain" class="<%= (filters.search === 'Mountain') ? 'active' : '' %>">Mountain camps</a>
            <a href="/campgrounds?search=Dooars" class="<%= (filters.search === 'Dooars') ? 'active' : '' %>">Dooars</a>
            <a href="/campgrounds?search=Darjeeling" class="<%= (filters.search === 'Darjeeling') ? 'active' : '' %>">Darjeeling</a>
        </div>

        <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'owner')) { %>
            <a href="/campgrounds/new" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Add New Camp
            </a>
        <% } %>
    </div>

    <!-- Results Count -->
    <div class="result-count">
        <strong><%= campgrounds.length %> stays</strong>
        <span>found across North Bengal</span>
    </div>

    <!-- Campgrounds Grid -->
    <% if (campgrounds && campgrounds.length > 0) { %>
        <div class="camp-grid explore-grid">
            <% for (let campground of campgrounds) { %>
                <article class="camp-card">
                    <div class="camp-image-wrap">
                        <img src="<%= campground.image || 'https://images.unsplash.com/photo-1504280114797-152864388e6e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' %>" alt="<%= campground.title %>">
                        <span class="image-tag">Verified stay</span>
                        <button class="heart" type="button" aria-label="Save camp">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                            </svg>
                        </button>
                    </div>

                    <div class="camp-card-body">
                        <div class="camp-meta">
                            <span>Nature Camp</span>
                            <span class="rating">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="#c8743d" stroke="#c8743d">
                                    <path d="m12 2 3 6 6.5 1-4.7 4.6 1.1 6.4-5.9-3.1L6.1 20l1.1-6.4L2.5 9 9 8l3-6Z" />
                                </svg>
                                4.9 <em>(reviews)</em>
                            </span>
                        </div>

                        <h3><%= campground.title %></h3>
                        
                        <p>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                                <circle cx="12" cy="10" r="2.5" />
                            </svg>
                            <%= campground.location %>
                        </p>

                        <% if (campground.description) { %>
                            <p class="text-secondary small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                                <%= campground.description %>
                            </p>
                        <% } %>

                        <div class="card-foot">
                            <div>
                                <strong>₹<%= campground.price ? Number(campground.price).toLocaleString('en-IN') : 0 %></strong>
                                <span> / night</span>
                            </div>
                            <a href="/campgrounds/<%= campground.id || campground._id %>">
                                View details
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </article>
            <% } %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-5 my-4 bg-white rounded-4 border p-5">
            <div class="mb-3">
                <i class="bi bi-tree text-success display-4"></i>
            </div>
            <h3 class="fw-bold mb-2">No campgrounds found</h3>
            <p class="text-muted mb-4">We couldn't find any stays matching your criteria. Try adjusting your search or budget.</p>
            <a href="/campgrounds" class="btn btn-primary">Clear all filters</a>
        </div>
    <% } %>
</main>

<% layout('layouts/boilerplate') %>
    <h1>All Campgrounds</h1>
  <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'owner')) { %>
  <div class="d-flex justify-content-end mb-3">
    <a href="/campgrounds/new" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Add New Campground
    </a>
  </div>
  <% } %>

  <form action="/campgrounds" method="GET" class="mb-4">
      <div class="row g-2">
          <div class="col-md-6">
              <input type="text" name="search" class="form-control" placeholder="Search by title or location..." value="<%= filters.search || '' %>">
          </div>
          <div class="col-md-4">
              <input type="number" name="maxPrice" class="form-control" placeholder="Max Price (₹)" value="<%= filters.maxPrice || '' %>">
          </div>
          <div class="col-md-2 d-flex gap-2">
              <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Search</button>
              <a href="/campgrounds" class="btn btn-secondary w-100">Clear</a>
          </div>
      </div>
  </form>

    <ul>
<div class="row">

    <% for (let campground of campgrounds) { %>

        <div class="col-md-4 mb-4">

            <div class="card h-100">

                <img src="<%= campground.image %>"
                     class="card-img-top"
                     alt="<%= campground.title %>">

                <div class="card-body">

                    <h5 class="card-title">
                        <%= campground.title %>
                    </h5>

                    <p class="card-text">
                        <%= campground.description %>
                    </p>

                    <p class="card-text">
                        <small class="text-muted">
                            <%= campground.location %>
                        </small>
                    </p>

                    <a href="/campgrounds/<%= campground._id %>"
                       class="btn btn-primary">
                        View Details
                    </a>

                </div>

            </div>

        </div>

    <% } %>

</div>

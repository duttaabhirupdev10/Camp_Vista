<% layout('layouts/boilerplate') %>
<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="mb-4">
            <p class="text-uppercase text-secondary small fw-semibold mb-2">Campground details</p>
            <h1 class="display-6 fw-bold mb-2">Edit campground</h1>
            <p class="text-secondary mb-0">Update the information for <%= campground.title %>.</p>
        </div>

        <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="border rounded-3 p-4 shadow-sm bg-white">
            <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Title</label>
                <input type="text" class="form-control" id="title" name="campground[title]" value="<%= campground.title %>" required>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label fw-semibold">Update Image (leave blank to keep current)</label>
                <input type="file" class="form-control" id="image" name="image" accept="image/*">
            </div>

            <div class="mb-3">
                <label for="qr_code" class="form-label fw-semibold">Update Payment QR Code (leave blank to keep current)</label>
                <input type="file" class="form-control" id="qr_code" name="qr_code" accept="image/*">
            </div>

            <div class="row g-3">
                <div class="col-md-7">
                    <label for="location" class="form-label fw-semibold">Location</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="location" name="campground[location]" value="<%= campground.location %>" required>
                        <button class="btn btn-outline-secondary" type="button" id="locateBtn" title="Use current location">
                            <i class="bi bi-geo-alt"></i>
                        </button>
                    </div>
                    <div id="locateHelp" class="form-text d-none text-success">Location found!</div>
                </div>
                <div class="col-md-5">
                    <label for="price" class="form-label fw-semibold">Price</label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input type="number" class="form-control" id="price" name="campground[price]" value="<%= campground.price %>" min="0" placeholder="0" required>
                    </div>
                </div>
            </div>

            <div class="mt-3 mb-4">
                <label for="description" class="form-label fw-semibold">Description</label>
                <textarea class="form-control" id="description" name="campground[description]" rows="5" required><%= campground.description %></textarea>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-dark">Update campground</button>
                <a href="/campgrounds/<%= campground._id %>" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
document.getElementById('locateBtn').addEventListener('click', () => {
    const locateBtn = document.getElementById('locateBtn');
    const locationInput = document.getElementById('location');
    const locateHelp = document.getElementById('locateHelp');
    
    if (!navigator.geolocation) {
        alert("Geolocation is not supported by your browser");
        return;
    }

    locateBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
    locateBtn.disabled = true;

    navigator.geolocation.getCurrentPosition(
        (position) => {
            const { latitude, longitude } = position.coords;
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`)
                .then(res => res.json())
                .then(data => {
                    locateBtn.innerHTML = '<i class="bi bi-geo-alt"></i>';
                    locateBtn.disabled = false;
                    
                    if (data && data.display_name) {
                        const address = data.address;
                        const city = address.city || address.town || address.village || address.county;
                        const state = address.state;
                        const country = address.country;
                        
                        if (city && state && country) {
                            locationInput.value = `${city}, ${state}, ${country}`;
                        } else {
                            locationInput.value = data.display_name;
                        }
                        
                        locateHelp.classList.remove('d-none');
                        setTimeout(() => locateHelp.classList.add('d-none'), 5000);
                    }
                })
                .catch(err => {
                    console.error(err);
                    locateBtn.innerHTML = '<i class="bi bi-geo-alt"></i>';
                    locateBtn.disabled = false;
                    alert("Unable to fetch location details.");
                });
        },
        (error) => {
            console.error(error);
            locateBtn.innerHTML = '<i class="bi bi-geo-alt"></i>';
            locateBtn.disabled = false;
            alert("Unable to retrieve your location.");
        }
    );
});
</script>

<% layout('layouts/boilerplate') %>

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="mb-4">
                <span class="eyebrow mb-2">
                    <span></span> HOST A CAMP
                </span>
                <h1 style="font-family: var(--serif); font-size: 38px;">List a New Campsite</h1>
                <p class="text-muted">Share your scenic property with adventurers across North Bengal.</p>
            </div>

            <div class="form-card">
                <form action="/campgrounds" method="POST" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label for="title" class="form-label">Campground Name</label>
                        <input type="text" class="form-control" id="title" name="campground[title]" placeholder="e.g. Lataguri Forest Camp" required>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <label for="location" class="form-label">Location / Region</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="location" name="campground[location]" placeholder="e.g. Lataguri, Dooars" required>
                                <button class="btn btn-outline" type="button" id="locateBtn" title="Use current GPS location">
                                    <i class="bi bi-geo-alt"></i>
                                </button>
                            </div>
                            <div id="locateHelp" class="form-text d-none text-success small mt-1">Location detected successfully!</div>
                        </div>

                        <div class="col-md-5">
                            <label for="price" class="form-label">Price per Night</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="number" class="form-control" id="price" name="campground[price]" placeholder="2500" min="0" required>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="total_rooms" class="form-label">Total Rooms Available</label>
                            <input type="number" class="form-control" id="total_rooms" name="campground[total_rooms]" placeholder="5" min="0" value="5" required>
                            <div class="form-text text-muted small">Number of rooms or tents available (set to 0 if none).</div>
                        </div>

                        <div class="col-md-6">
                            <label for="room_capacity" class="form-label">Max People per Room</label>
                            <input type="number" class="form-control" id="room_capacity" name="campground[room_capacity]" placeholder="2" min="1" value="2" required>
                            <div class="form-text text-muted small">How many people are allowed to stay together in one room.</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="image" class="form-label">Camp Cover Photo</label>
                        <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
                        <div class="form-text text-muted small">Upload high-resolution landscape images of your campsite.</div>
                    </div>

                    <div class="mb-4">
                        <label for="qr_code" class="form-label">Owner UPI Payment QR Code</label>
                        <input type="file" class="form-control" id="qr_code" name="qr_code" accept="image/*" required>
                        <div class="form-text text-muted small">Customers will scan this QR code to transfer payment directly to you.</div>
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label">Experience &amp; Description</label>
                        <textarea class="form-control" id="description" name="campground[description]" rows="5" placeholder="Describe the atmosphere, nearby wildlife, trekking trails, amenities, and surroundings..." required></textarea>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-primary py-2 px-4">
                            Publish Campground
                        </button>
                        <a href="/campgrounds" class="btn btn-outline py-2">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<script>
document.getElementById('locateBtn').addEventListener('click', () => {
    const locateBtn = document.getElementById('locateBtn');
    const locationInput = document.getElementById('location');
    const locateHelp = document.getElementById('locateHelp');
    
    if (!navigator.geolocation) {
        alert("Geolocation is not supported by your browser");
        return;
    }

    locateBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
    locateBtn.disabled = true;

    navigator.geolocation.getCurrentPosition(
        async (position) => {
            const { latitude, longitude } = position.coords;
            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`);
                const data = await response.json();
                
                if (data && data.address) {
                    const city = data.address.city || data.address.town || data.address.village || data.address.county || "";
                    const state = data.address.state || "";
                    locationInput.value = `${city}${city && state ? ', ' : ''}${state}`;
                    locateHelp.classList.remove('d-none');
                } else {
                    locationInput.value = `${latitude.toFixed(4)}, ${longitude.toFixed(4)}`;
                }
            } catch (err) {
                locationInput.value = `${latitude.toFixed(4)}, ${longitude.toFixed(4)}`;
            } finally {
                locateBtn.innerHTML = '<i class="bi bi-geo-alt"></i>';
                locateBtn.disabled = false;
            }
        },
        (error) => {
            alert("Unable to retrieve location: " + error.message);
            locateBtn.innerHTML = '<i class="bi bi-geo-alt"></i>';
            locateBtn.disabled = false;
        }
    );
});
</script>

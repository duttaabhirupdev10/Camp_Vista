<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Campground</title>
</head>
<body>
    <form action="/campgrounds" method="POST">
        <label for="title">Title:</label>
        <input type="text" id="title" name="campground[title]" required><br><br>
        
        <label for="location">Location:</label>
        <input type="text" id="location" name="campground[location]" required><br><br>
        
        <label for="description">Description:</label>
        <textarea id="description" name="campground[description]" required></textarea><br><br>
        
        <button type="submit">Create Campground</button></form>
        <a href="/campgrounds">All Campgrounds</a>
</body>
</html>
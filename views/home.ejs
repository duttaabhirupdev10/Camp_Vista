<% layout('layouts/boilerplate') %>

<!-- HERO SECTION -->
<section class="hero" style="background-image: url('https://images.unsplash.com/photo-1503265192943-9d7eea6fc77a?auto=format&fit=crop&w=2000&q=88');">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <span class="eyebrow light">
            <span></span> Your gateway to the wild
        </span>
        <h1>
            Discover your<br>
            next <em>escape.</em>
        </h1>
        <p>
            Hidden camps, wild forests and Himalayan horizons — curated across North Bengal.
        </p>

        <!-- Search Panel Form -->
        <form action="/campgrounds" method="GET" class="search-panel">
            <label class="search-main">
                <span>Where</span>
                <div>
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-4-4" />
                    </svg>
                    <input type="text" name="search" placeholder="Search destination or camp" aria-label="Destination">
                </div>
            </label>

            <label>
                <span>Check in</span>
                <div>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M16 3v4M8 3v4M3 10h18" />
                    </svg>
                    <input type="date" name="check_in" aria-label="Check in">
                </div>
            </label>

            <label>
                <span>Check out</span>
                <div>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M16 3v4M8 3v4M3 10h18" />
                    </svg>
                    <input type="date" name="check_out" aria-label="Check out">
                </div>
            </label>

            <label>
                <span>Max Budget (₹)</span>
                <div>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 6h15a2 2 0 0 1 2 2v11H4a2 2 0 0 1-2-2V5a3 3 0 0 1 3-3h13" />
                        <path d="M16 12h5" />
                    </svg>
                    <input type="number" name="maxPrice" placeholder="Any price" aria-label="Max budget">
                </div>
            </label>

            <button type="submit" class="btn btn-primary" aria-label="Search camps">
                Search
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                </svg>
            </button>
        </form>

        <!-- Quick Keyword Search Suggestions -->
        <div class="popular">
            <span>Popular:</span>
            <a href="/campgrounds?search=Darjeeling">Darjeeling</a>
            <a href="/campgrounds?search=Dooars">Dooars</a>
            <a href="/campgrounds?search=Lataguri">Lataguri</a>
            <a href="/campgrounds?search=Jaldapara">Jaldapara</a>
            <a href="/campgrounds?search=Kalimpong">Kalimpong</a>
        </div>
    </div>

    <div class="hero-side-note">
        <span>27.04° N</span>
        <i></i>
        <span>Himalayan foothills</span>
    </div>
</section>

<!-- CURATED REGIONS SECTION -->
<section class="section container">
    <div class="section-head">
        <div>
            <span class="eyebrow">
                <span></span> Curated destinations
            </span>
            <h2>Explore North Bengal</h2>
            <p>From misty mountain trails to the wild heart of the Dooars.</p>
        </div>
        <a href="/campgrounds">
            View all destinations
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
        </a>
    </div>

    <div class="destination-grid">
        <a href="/campgrounds?search=Darjeeling" class="destination-card dest-1">
            <img src="https://images.unsplash.com/photo-1626082895617-2c6de34f6af3?auto=format&fit=crop&w=1000&q=85" alt="Darjeeling">
            <span class="shade"></span>
            <span class="destination-copy">
                <small>01</small>
                <strong>Darjeeling</strong>
                <em>Misty peaks & tea trails</em>
            </span>
            <i>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </i>
        </a>

        <a href="/campgrounds?search=Dooars" class="destination-card dest-2">
            <img src="https://images.unsplash.com/photo-1579063890939-deb71d85a91a?auto=format&fit=crop&w=1000&q=85" alt="Dooars">
            <span class="shade"></span>
            <span class="destination-copy">
                <small>02</small>
                <strong>Dooars</strong>
                <em>Wild forests & rivers</em>
            </span>
            <i>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </i>
        </a>

        <a href="/campgrounds?search=Jaldapara" class="destination-card dest-3">
            <img src="https://images.unsplash.com/photo-1608048328465-84421e96c412?auto=format&fit=crop&w=1000&q=85" alt="Jaldapara">
            <span class="shade"></span>
            <span class="destination-copy">
                <small>03</small>
                <strong>Jaldapara</strong>
                <em>Jungle & wildlife</em>
            </span>
            <i>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </i>
        </a>

        <a href="/campgrounds?search=Kalimpong" class="destination-card dest-4">
            <img src="https://images.unsplash.com/photo-1455157823797-3019317cbcf0?auto=format&fit=crop&w=1000&q=85" alt="Kalimpong">
            <span class="shade"></span>
            <span class="destination-copy">
                <small>04</small>
                <strong>Kalimpong</strong>
                <em>Hillside hideaways</em>
            </span>
            <i>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </i>
        </a>
    </div>
</section>

<!-- POPULAR CAMPS SECTION -->
<section class="section popular-section">
    <div class="container">
        <div class="section-head">
            <div>
                <span class="eyebrow">
                    <span></span> Loved by travellers
                </span>
                <h2>Popular camps</h2>
                <p>One-of-a-kind stays, chosen for their setting, story and soul.</p>
            </div>
            <a href="/campgrounds">
                Explore all camps
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
            </a>
        </div>

        <div class="camp-grid">
            <% if (typeof campgrounds !== 'undefined' && campgrounds && campgrounds.length > 0) { %>
                <% for (let camp of campgrounds.slice(0, 3)) { %>
                    <article class="camp-card">
                        <div class="camp-image-wrap">
                            <img src="<%= camp.image || 'https://images.unsplash.com/photo-1715092387304-ef4d5f41ffdb?auto=format&fit=crop&w=1000&q=85' %>" alt="<%= camp.title %>">
                            <span class="image-tag">Guest favourite</span>
                            <button class="heart" type="button" aria-label="Save camp">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                                </svg>
                            </button>
                        </div>
                        <div class="camp-card-body">
                            <div class="camp-meta">
                                <span>Nature stay</span>
                                <span class="rating">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#c8743d" stroke="#c8743d">
                                        <path d="m12 2 3 6 6.5 1-4.7 4.6 1.1 6.4-5.9-3.1L6.1 20l1.1-6.4L2.5 9 9 8l3-6Z" />
                                    </svg>
                                    4.9 <em>(reviews)</em>
                                </span>
                            </div>
                            <h3><%= camp.title %></h3>
                            <p>
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                                    <circle cx="12" cy="10" r="2.5" />
                                </svg>
                                <%= camp.location %>
                            </p>
                            <div class="camp-availability">
                                <% const availRooms = Number(camp.available_rooms ?? 0); %>
                                <% if (availRooms > 0) { %>
                                    <span class="availability-badge available">
                                        <i class="bi bi-door-open"></i>
                                        <%= availRooms %> <%= availRooms === 1 ? 'room' : 'rooms' %> available
                                    </span>
                                <% } else { %>
                                    <span class="availability-badge sold-out">
                                        <i class="bi bi-x-circle"></i>
                                        No rooms available
                                    </span>
                                <% } %>
                            </div>
                            <div class="card-foot">
                                <div>
                                    <strong>₹<%= camp.price ? Number(camp.price).toLocaleString('en-IN') : 0 %></strong>
                                    <span> / night</span>
                                </div>
                                <a href="/campgrounds/<%= camp.id %>">
                                    View details
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M5 12h14M13 6l6 6-6 6" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                <% } %>
            <% } else { %>
                <!-- Curated fallback stays if database is empty -->
                <article class="camp-card">
                    <div class="camp-image-wrap">
                        <img src="https://images.unsplash.com/photo-1715092387304-ef4d5f41ffdb?auto=format&fit=crop&w=1000&q=85" alt="Lataguri Forest Camp">
                        <span class="image-tag">Guest favourite</span>
                        <button class="heart" type="button" aria-label="Save camp">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                            </svg>
                        </button>
                    </div>
                    <div class="camp-card-body">
                        <div class="camp-meta">
                            <span>Forest camp</span>
                            <span class="rating">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="#c8743d" stroke="#c8743d"><path d="m12 2 3 6 6.5 1-4.7 4.6 1.1 6.4-5.9-3.1L6.1 20l1.1-6.4L2.5 9 9 8l3-6Z" /></svg>
                                4.9 <em>(124)</em>
                            </span>
                        </div>
                        <h3>Lataguri Forest Camp</h3>
                        <p>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                            Lataguri, Dooars
                        </p>
                        <div class="card-foot">
                            <div><strong>₹2,500</strong><span> / night</span></div>
                            <a href="/campgrounds">View details <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
                        </div>
                    </div>
                </article>

                <article class="camp-card">
                    <div class="camp-image-wrap">
                        <img src="https://images.unsplash.com/photo-1608048328465-84421e96c412?auto=format&fit=crop&w=1000&q=85" alt="Jaldapara Jungle Retreat">
                        <span class="image-tag">Wildlife escape</span>
                        <button class="heart" type="button" aria-label="Save camp">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                            </svg>
                        </button>
                    </div>
                    <div class="camp-card-body">
                        <div class="camp-meta">
                            <span>Jungle stay</span>
                            <span class="rating">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="#c8743d" stroke="#c8743d"><path d="m12 2 3 6 6.5 1-4.7 4.6 1.1 6.4-5.9-3.1L6.1 20l1.1-6.4L2.5 9 9 8l3-6Z" /></svg>
                                4.8 <em>(86)</em>
                            </span>
                        </div>
                        <h3>Jaldapara Jungle Retreat</h3>
                        <p>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                            Jaldapara, Alipurduar
                        </p>
                        <div class="card-foot">
                            <div><strong>₹3,200</strong><span> / night</span></div>
                            <a href="/campgrounds">View details <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
                        </div>
                    </div>
                </article>

                <article class="camp-card">
                    <div class="camp-image-wrap">
                        <img src="https://images.unsplash.com/photo-1554867874-19fcf1c51d5c?auto=format&fit=crop&w=1000&q=85" alt="Jhalong River Camp">
                        <span class="image-tag">Riverside</span>
                        <button class="heart" type="button" aria-label="Save camp">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                            </svg>
                        </button>
                    </div>
                    <div class="camp-card-body">
                        <div class="camp-meta">
                            <span>River camp</span>
                            <span class="rating">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="#c8743d" stroke="#c8743d"><path d="m12 2 3 6 6.5 1-4.7 4.6 1.1 6.4-5.9-3.1L6.1 20l1.1-6.4L2.5 9 9 8l3-6Z" /></svg>
                                4.7 <em>(68)</em>
                            </span>
                        </div>
                        <h3>Jhalong River Camp</h3>
                        <p>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                            Jhalong, Kalimpong
                        </p>
                        <div class="card-foot">
                            <div><strong>₹2,800</strong><span> / night</span></div>
                            <a href="/campgrounds">View details <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
                        </div>
                    </div>
                </article>
            <% } %>
        </div>
    </div>
</section>

<!-- WHY CAMPVISTA SECTION -->
<section class="section why-section container" id="why-campvista">
    <div class="why-intro">
        <span class="eyebrow">
            <span></span> Why CampVista
        </span>
        <h2>
            Wild places.<br>
            <em>Peace of mind.</em>
        </h2>
        <p>
            We make getting away feel effortless, so you can spend less time planning and more time outside in nature.
        </p>
        <a href="/campgrounds" class="btn btn-outline">
            How it works
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
        </a>
    </div>

    <div class="feature-grid">
        <article class="feature">
            <span>01</span>
            <i>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>
            </i>
            <h3>Verified stays</h3>
            <p>Every camp is personally vetted for hygiene, safety, authentic wilderness surroundings, and hospitality.</p>
        </article>

        <article class="feature">
            <span>02</span>
            <i>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4M8 3v4M3 10h18" />
                </svg>
            </i>
            <h3>Easy booking</h3>
            <p>Direct date selection, clear night breakdowns, and instant confirmation from verified campsite owners.</p>
        </article>

        <article class="feature">
            <span>03</span>
            <i>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 6h15a2 2 0 0 1 2 2v11H4a2 2 0 0 1-2-2V5a3 3 0 0 1 3-3h13" />
                    <path d="M16 12h5" />
                </svg>
            </i>
            <h3>Direct UPI QR</h3>
            <p>Convenient UPI payments straight to the campground host with transparent pricing and zero hidden fees.</p>
        </article>

        <article class="feature">
            <span>04</span>
            <i>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" />
                </svg>
            </i>
            <h3>Hidden places</h3>
            <p>Discover private riverside camps, forest hideaways, and high-altitude tea trails off the crowded tourist route.</p>
        </article>
    </div>
</section>

<!-- CALL TO ACTION SECTION -->
<section class="container cta" style="background-image: url('https://images.unsplash.com/photo-1554867874-19fcf1c51d5c?auto=format&fit=crop&w=1600&q=85');">
    <div>
        <span class="eyebrow light">
            <span></span> Answer the call
        </span>
        <h2>
            Your next adventure<br>
            is waiting.
        </h2>
        <p>
            Leave the ordinary behind. North Bengal is closer than you think.
        </p>
        <a href="/campgrounds" class="btn btn-secondary">
            Explore camps
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
        </a>
    </div>
</section>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampVista | North Bengal</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: #0f172a;
        }

        .hero-section {
            height: 100vh;
            background: linear-gradient(
                rgba(15, 23, 42, 0.7), 
                rgba(15, 23, 42, 0.8)
            ), url('https://images.unsplash.com/photo-1582424161962-d249f3e9d891?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 4rem;
            max-width: 800px;
            width: 90%;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            transform: translateY(0);
            transition: transform 0.3s ease;
        }
        
        .glass-card:hover {
            transform: translateY(-5px);
        }

        .title {
            font-size: 4.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(to right, #4ade80, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.05em;
        }

        .subtitle {
            font-size: 1.25rem;
            font-weight: 300;
            margin-bottom: 3rem;
            color: #cbd5e1;
            line-height: 1.6;
        }

        .btn-custom {
            padding: 1rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, #4ade80 0%, #3b82f6 100%);
            color: white;
            box-shadow: 0 10px 20px -10px rgba(74, 222, 128, 0.5);
        }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -10px rgba(74, 222, 128, 0.7);
            color: white;
        }

        .btn-outline-custom {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(5px);
        }

        .btn-outline-custom:hover {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            transform: translateY(-2px);
        }

        .floating-elements {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .circle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(74,222,128,0.15) 0%, rgba(0,0,0,0) 70%);
        }

        .circle-1 {
            width: 600px;
            height: 600px;
            top: -200px;
            left: -200px;
        }

        .circle-2 {
            width: 800px;
            height: 800px;
            bottom: -300px;
            right: -200px;
            background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, rgba(0,0,0,0) 70%);
        }
    </style>
</head>
<body>

    <section class="hero-section">
        <div class="floating-elements">
            <div class="circle circle-1"></div>
            <div class="circle circle-2"></div>
        </div>

        <div class="glass-card position-relative" style="z-index: 2;">
            <h1 class="title">CampVista</h1>
            <p class="subtitle">Discover the most breathtaking camping destinations across the Himalayas, Darjeeling, and the Dooars. Connect with nature like never before.</p>
            
            <div class="d-flex justify-content-center gap-4 flex-wrap">
                <a href="/campgrounds" class="btn btn-custom btn-primary-custom text-decoration-none">Explore North Bengal</a>
                
                <% if(currentUser) { %>
                    <form action="/logout" method="POST" class="d-inline">
                        <button class="btn btn-custom btn-outline-custom">Logout</button>
                    </form>
                <% } else { %>
                    <a href="/login" class="btn btn-custom btn-outline-custom text-decoration-none">Login</a>
                    <a href="/register" class="btn btn-custom btn-outline-custom text-decoration-none">Register</a>
                <% } %>
            </div>
        </div>
    </section>

</body>
</html>